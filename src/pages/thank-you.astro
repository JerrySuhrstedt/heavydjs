---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Thank You - Heavy DJs" description="Thanks for reaching out to Heavy DJs — we'll be in touch soon.">
  <section class="thanks">
    <div class="container thanks-inner reveal">
      <p class="eyebrow">Thank You</p>
      <h1>Got it — thanks for reaching out!</h1>
      <p>
        We've received your information and will follow up shortly with availability and next
        steps for your event.
      </p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    min-height: 55vh;
    display: flex;
    align-items: center;
  }

  .thanks-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .thanks-inner h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin: 0.5rem 0 1rem;
  }

  .thanks-inner p {
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }
</style>
