---
import BaseLayout from "../layouts/BaseLayout.astro";

const youtubeId = "P6H_e8Rh21w";
---

<BaseLayout title="JJ Nite Demo Reel - Heavy DJs" description="Watch JJ Nite's DJ and emcee demo reel.">
  <section class="reel-section">
    <div class="container reveal">
      <p class="eyebrow">See Him In Action</p>
      <h1>JJ Nite Demo Reel</h1>
      <div class="reel-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
          title="JJ Nite Demo Reel"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
      <a href="/contact/" class="btn btn-primary">Book JJ For Your Event</a>
    </div>
  </section>
</BaseLayout>

<style>
  .reel-section {
    text-align: center;
  }

  .reel-section h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0.5rem 0 2rem;
  }

  .reel-frame {
    position: relative;
    width: 100%;
    max-width: 860px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    margin: 0 auto 2rem;
  }

  .reel-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
