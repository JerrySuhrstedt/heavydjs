---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import EventForm from "../components/EventForm.astro";
---

<BaseLayout title="Contact - Heavy DJs" description="Get in touch with Heavy DJs, based in Chandler, Arizona." showFooterCta={false}>
  <section class="contact-hero">
    <div class="container reveal">
      <p class="eyebrow">Get In Touch</p>
      <h1>Let's talk about your event</h1>
    </div>
  </section>

  <section class="contact-main">
    <div class="container contact-grid">
      <div class="reveal">
        <EventForm title="Request a Quote" />
      </div>

      <div class="contact-side">
        <Photo src="/images/contact-house-party.webp" alt="Heavy DJs house party" ratio="768 / 669" class="reveal" />
        <div class="contact-details reveal">
          <h2>Heavy DJs is located in Chandler Arizona</h2>
          <p>Chandler, AZ, USA</p>
          <p><a href="tel:+14808269400">(480) 826-9400</a></p>
          <p><a href="mailto:info@heavydjs.com">info@heavydjs.com</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    text-align: center;
  }

  .contact-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    margin-top: 0.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-details h2 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
  }

  .contact-details p {
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  .contact-details a {
    color: var(--pink);
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
