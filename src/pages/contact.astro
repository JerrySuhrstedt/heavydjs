---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
---

<BaseLayout title="Contact - Heavy DJs" description="Get in touch with Heavy DJs, based in Chandler, Arizona.">
  <section class="contact-hero">
    <div class="container reveal">
      <p class="eyebrow">Get In Touch</p>
      <h1>Let's talk about your event</h1>
    </div>
  </section>

  <section class="contact-main">
    <div class="container contact-grid">
      <form class="card contact-form reveal">
        <label>
          Name
          <input type="text" name="name" placeholder="Your name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" placeholder="you@email.com" required />
        </label>
        <label>
          Event Date
          <input type="date" name="event-date" />
        </label>
        <label>
          Tell us about your event
          <textarea name="message" rows="5" placeholder="Wedding, corporate event, private party..."></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Request a Quote</button>
        <p class="form-note">This form isn't wired up to send yet — connect it to your booking backend when ready.</p>
      </form>

      <div class="contact-side">
        <Photo src="/images/contact-house-party.webp" alt="Heavy DJs house party" ratio="768 / 669" class="reveal" />
        <div class="contact-details reveal">
          <h2>Heavy DJs is located in Chandler Arizona</h2>
          <p>Chandler, AZ, USA</p>
          <p><a href="tel:+14808269400">(480) 826-9400</a></p>
          <p><a href="mailto:info@heavydjs.com">info@heavydjs.com</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    text-align: center;
  }

  .contact-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    margin-top: 0.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .contact-form input,
  .contact-form textarea {
    font: inherit;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgb(23 20 15 / 0.15);
    background: var(--cream);
    color: var(--ink);
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--pink);
    outline-offset: 1px;
  }

  .form-note {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .contact-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-details h2 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
  }

  .contact-details p {
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  .contact-details a {
    color: var(--pink);
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
