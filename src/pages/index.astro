---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import BentoGrid from "../components/BentoGrid.astro";
import Gallery from "../components/Gallery.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Faq from "../components/Faq.astro";
import Photo from "../components/Photo.astro";
import { shortTestimonials, longTestimonials } from "../data/testimonials";
import { BUSINESS } from "../data/business";

// Some people (Petar Cale) appear in both testimonial lists with reworded
// quotes — dedupe by name so the same reviewer isn't counted twice in
// reviewCount.
const allTestimonials = [...shortTestimonials, ...longTestimonials];
const uniqueTestimonials = allTestimonials.filter(
  (t, i) => allTestimonials.findIndex((other) => other.name === t.name) === i
);

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "EntertainmentBusiness",
  name: BUSINESS.name,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: 5,
    bestRating: 5,
    reviewCount: uniqueTestimonials.length,
  },
  review: uniqueTestimonials.map((t) => ({
    "@type": "Review",
    author: { "@type": "Person", name: t.name },
    reviewRating: { "@type": "Rating", ratingValue: t.rating ?? 5, bestRating: 5 },
    reviewBody: t.quote,
  })),
};

const bands = [
  { src: "/images/band-awb.webp", alt: "Average White Band" },
  { src: "/images/band-isley.webp", alt: "The Isley Brothers" },
  { src: "/images/band-tower-of-power.webp", alt: "Tower of Power" },
  { src: "/images/band-barkays.webp", alt: "The Bar-Kays" },
];

const valueProps = [
  {
    title: "Personalized Experience",
    body: "With over 25 years in the industry, we tailor every performance to match your event's vibe and your crowd's energy.",
  },
  {
    title: "Complete Entertainment",
    body: "We handle both the music and the flow of your event with expert emceeing, making sure everything runs smoothly.",
  },
  {
    title: "Crowd Reading Expertise",
    body: "From weddings to corporate events, we know how to read a room and play the right music to keep everyone engaged and on the dance floor.",
  },
];
---

<BaseLayout title="Home - Heavy DJs">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(reviewSchema)} />

  <HomeHero />

  <section class="testimonial-strip">
    <div class="container testimonial-grid">
      {shortTestimonials.map((t) => <TestimonialCard testimonial={t} />)}
    </div>
  </section>

  <BentoGrid />

  <section class="problem-section">
    <div class="container problem-grid">
      <h2 class="problem-title reveal">Did your Last Event Fall Flat?</h2>
      <div class="problem-copy reveal">
        <h3>Does this sound familiar?</h3>
        <ul class="problem-list">
          <li>The atmosphere feels dull, and guests aren't excited.</li>
          <li>The playlist isn't connecting with the crowd.</li>
          <li>There's no flow, and the event feels disorganized.</li>
        </ul>
      </div>
    </div>
  </section>

  <Gallery />

  <section class="video-section">
    <div class="container">
      <h2 class="video-title reveal">We bring the party to your party</h2>
      <div class="video-frame reveal">
        <iframe
          src="https://www.youtube-nocookie.com/embed/P6H_e8Rh21w"
          title="Heavy DJs | Mobile DJ Service"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="bio-section">
    <div class="container bio-grid">
      <Photo
        src="/images/home-dj-vintage.webp"
        alt="JJ Nite behind the decks"
        ratio="2 / 3"
        class="bio-photo reveal"
      />
      <div class="bio-copy reveal">
        <img src="/images/jj-nite-banner.webp" alt="JJ Nite" class="jj-banner" />
        <h2>Senior DJ | Emcee</h2>
        <p>
          With over three decades of experience, JJ Nite has become a renowned DJ and emcee, known
          for delivering unforgettable entertainment experiences. His journey began with 12 years
          as a radio broadcaster at Seattle's iconic KFOX Radio, where he sharpened his ear for
          music and cultivated a deep love for funk and soul. As a night club DJ in Seattle, JJ
          further refined his talent for reading crowds and curating the perfect playlist to match
          any occasion.
        </p>
        <p class="bio-credit">
          Emcee for Average White Band, Isley Brothers, Tower of Power, Bar-Kays
        </p>
        <ul class="band-row">
          {
            bands.map((band) => (
              <li>
                <img src={band.src} alt={band.alt} loading="lazy" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="fix-section">
    <div class="fix-video" aria-hidden="true" data-video-src="https://www.youtube-nocookie.com/embed/dGNIorj5tSQ?autoplay=1&mute=1&loop=1&playlist=dGNIorj5tSQ&controls=0&showinfo=0&modestbranding=1&playsinline=1">
    </div>
    <div class="container fix-grid">
      <h2 class="fix-title reveal">Bring Your Event to Life with Heavy DJs!</h2>
      <div class="fix-copy reveal">
        <h3>Here's how we fix it:</h3>
        <ul class="fix-list">
          <li>We read the crowd and play the perfect mix to keep everyone dancing.</li>
          <li>Our professional emcees ensure smooth transitions and keep your event on track.</li>
          <li>
            We create an energetic, unforgettable atmosphere that will have your guests talking
            long after the party ends.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="values-section">
    <div class="container values-grid">
      {
        valueProps.map((v) => (
          <div class="value-item reveal">
            <svg class="value-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M9 18V5l12-2v13" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <FeatureGrid />
  <Faq />

  <section class="testimonial-strip testimonial-strip--long">
    <div class="container testimonial-grid">
      {longTestimonials.map((t) => <TestimonialCard testimonial={t} variant="blue" />)}
    </div>
  </section>

  <script>
    // Only mount the background video once the section is near the viewport, and
    // skip it entirely for users who prefer reduced motion.
    const holder = document.querySelector<HTMLElement>(".fix-video");
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (holder && !prefersReduced) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const iframe = document.createElement("iframe");
            iframe.src = holder.dataset.videoSrc ?? "";
            iframe.tabIndex = -1;
            iframe.setAttribute("allow", "autoplay; encrypted-media");
            iframe.setAttribute("title", "");
            holder.appendChild(iframe);
            io.disconnect();
          }
        },
        { rootMargin: "200px" }
      );
      io.observe(holder);
    }
  </script>
</BaseLayout>

<style>
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 800px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Did your last event fall flat — the original is two equal 509px columns
     pinned to the container edges; equal widths are what keep the heading
     stacked over three lines and the first list item wrapping to two */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 509px));
    justify-content: space-between;
    gap: 2.5rem;
    align-items: start;
  }

  /* original: 44.8px / 500 / 44.8px */
  .problem-copy h3 {
    font-size: 2.8rem;
    font-weight: 500;
    line-height: 1;
    margin-bottom: 1rem;
  }

  /* original list items: 19.2px / 600 / 28.8px */
  .problem-list,
  .fix-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .problem-list li,
  .fix-list li {
    position: relative;
    padding-left: 1.4rem;
  }

  .problem-list li::before,
  .fix-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Black video section */
  .video-section {
    background: #000;
    color: #fff;
    text-align: center;
  }

  .video-title {
    margin-bottom: 2rem;
  }

  .video-frame {
    position: relative;
    width: 100%;
    max-width: 1098px;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* JJ bio */
  .bio-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .bio-photo {
    max-width: 440px;
  }

  .jj-banner {
    height: 44px;
    width: auto;
    margin-bottom: 0.75rem;
  }

  /* original renders this in Public Sans 19.2/600 with an oversized 80px
     line-height, which is what gives the bio paragraph its air above */
  .bio-copy h2 {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 80px;
    margin-bottom: 0;
  }

  .bio-copy p {
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .bio-credit {
    font-weight: 400;
  }

  .band-row {
    display: flex;
    flex-wrap: wrap;
    gap: 19px;
  }

  .band-row img {
    width: 133px;
    height: 133px;
    object-fit: cover;
  }

  /* Fix section — original uses a muted YouTube video background behind white text */
  .fix-section {
    position: relative;
    background: var(--pink);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .fix-video {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* :global — the iframe is created in JS, so it never carries Astro's scope attribute */
  .fix-video :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-height: 100%;
    min-width: 177.78vh;
    transform: translate(-50%, -50%);
    border: 0;
  }

  .fix-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* original: 38.4px / 400 / 48px */
  .fix-copy h3 {
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  /* Value props */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    text-align: center;
  }

  .value-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .value-icon {
    width: 34px;
    height: 34px;
    color: var(--ink);
  }

  /* original value-prop headings: 38.4px / 400 / 48px */
  .value-item h3 {
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .value-item p {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .problem-grid,
    .fix-grid,
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .values-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .bio-photo {
      max-width: 260px;
      margin-inline: auto;
    }
  }
</style>
