---
import Sparkle from "./Sparkle.astro";
import EventForm from "./EventForm.astro";
import { FOOTER_CTA_VARIANT } from "../data/forms";

interface Props {
  variant?: "inline" | "popup";
}

const { variant = FOOTER_CTA_VARIANT } = Astro.props;
---

<section class="footer-cta">
  <div class="container cta-inner">
    <Sparkle color="var(--yellow)" size={22} class="cta-deco cta-deco-1" />
    <Sparkle color="var(--blue)" size={16} class="cta-deco cta-deco-2" />

    <div class="cta-copy">
      <h2>Is your date still open?</h2>
      <p>Tell us when you're celebrating and we'll check availability.</p>
    </div>

    {
      variant === "popup" ? (
        <button type="button" class="btn btn-primary cta-button" data-open-cta-modal>
          Check My Date
        </button>
      ) : (
        <div class="cta-form">
          <EventForm title="Check My Date" />
        </div>
      )
    }
  </div>

  {
    variant === "popup" && (
      <dialog class="cta-modal" data-cta-modal>
        <button type="button" class="cta-modal-close" data-close-cta-modal aria-label="Close">
          &times;
        </button>
        <EventForm title="Check My Date" />
      </dialog>
    )
  }
</section>

<style>
  .footer-cta {
    background: var(--cream-soft);
    border-top: 1px solid var(--hairline);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }

  .cta-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }

  .cta-copy h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-bottom: 0.35rem;
  }

  .cta-copy p {
    color: var(--ink-soft);
  }

  .cta-form {
    flex: 1 1 380px;
    min-width: 300px;
    max-width: 460px;
  }

  .cta-button {
    flex-shrink: 0;
  }

  .cta-deco {
    position: absolute;
    pointer-events: none;
  }

  .cta-deco-1 {
    top: -8px;
    left: 32%;
  }

  .cta-deco-2 {
    bottom: 4%;
    right: 42%;
  }

  .cta-modal {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 480px;
    width: calc(100% - 2.5rem);
    max-height: min(85vh, 900px);
    overflow: visible;
  }

  .cta-modal::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .cta-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .cta-modal :global(.event-form-wrap) {
    max-height: min(85vh, 900px);
    overflow-y: auto;
  }

  .cta-modal-close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--on-color);
    color: #fff;
    border: 2px solid var(--yellow);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  @media (max-width: 700px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-form {
      width: 100%;
      max-width: none;
    }

    .cta-deco {
      display: none;
    }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>("[data-cta-modal]");
  const openBtn = document.querySelector<HTMLElement>("[data-open-cta-modal]");
  const closeBtn = document.querySelector<HTMLElement>("[data-close-cta-modal]");

  openBtn?.addEventListener("click", () => modal?.showModal());
  closeBtn?.addEventListener("click", () => modal?.close());

  // Click on the backdrop (the dialog element itself, outside its content box) closes it.
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) modal.close();
  });
</script>
