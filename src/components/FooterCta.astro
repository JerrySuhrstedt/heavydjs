---
import Sparkle from "./Sparkle.astro";
import { TALLY_FORM_ID, FOOTER_CTA_VARIANT, tallyEmbedSrc } from "../data/forms";

interface Props {
  variant?: "inline" | "popup";
}

const { variant = FOOTER_CTA_VARIANT } = Astro.props;

// Note: Tally's widget auto-binds the data-tally-* attributes on the popup
// button. Don't also call Tally.openPopup() by hand — the modal opens twice.
---

<section class="footer-cta">
  <div class="container cta-inner">
    <Sparkle color="var(--yellow)" size={22} class="cta-deco cta-deco-1" />
    <Sparkle color="var(--blue)" size={16} class="cta-deco cta-deco-2" />

    <div class="cta-copy">
      <h2>Is your date still open?</h2>
      <p>Tell us when you're celebrating and we'll check availability.</p>
    </div>

    {
      variant === "popup" ? (
        <button
          type="button"
          class="btn btn-primary cta-button"
          data-tally-open={TALLY_FORM_ID}
          data-tally-layout="modal"
          data-tally-width="520"
          data-tally-overlay="1"
        >
          Check My Date
        </button>
      ) : (
        <div class="cta-form">
          <iframe
            data-tally-src={tallyEmbedSrc(TALLY_FORM_ID)}
            loading="lazy"
            width="100%"
            height="220"
            frameborder="0"
            title="Check your date"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .footer-cta {
    background: var(--cream-soft);
    border-top: 1px solid var(--hairline);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }

  .cta-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }

  .cta-copy h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-bottom: 0.35rem;
  }

  .cta-copy p {
    color: var(--ink-soft);
  }

  .cta-form {
    flex: 1 1 380px;
    min-width: 300px;
    max-width: 460px;
  }

  .cta-form iframe {
    width: 100%;
    border: 0;
    display: block;
  }

  .cta-button {
    flex-shrink: 0;
  }

  .cta-deco {
    position: absolute;
    pointer-events: none;
  }

  .cta-deco-1 {
    top: -8px;
    left: 32%;
  }

  .cta-deco-2 {
    bottom: 4%;
    right: 42%;
  }

  @media (max-width: 700px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-form {
      width: 100%;
      max-width: none;
    }

    .cta-deco {
      display: none;
    }
  }
</style>

<script>
  const TALLY_SCRIPT = "https://tally.so/widgets/embed.js";

  function ready() {
    const Tally = (window as any).Tally;
    if (Tally) {
      Tally.loadEmbeds();
      return;
    }
    // If the widget script is blocked, still show any inline frames.
    document.querySelectorAll<HTMLIFrameElement>("iframe[data-tally-src]").forEach((frame) => {
      if (!frame.src) frame.src = frame.dataset.tallySrc!;
    });
  }

  const needsTally =
    document.querySelector("iframe[data-tally-src]") || document.querySelector("[data-tally-open]");

  if (needsTally) {
    if (document.querySelector(`script[src="${TALLY_SCRIPT}"]`)) {
      ready();
    } else {
      const script = document.createElement("script");
      script.src = TALLY_SCRIPT;
      script.onload = ready;
      script.onerror = ready;
      document.body.appendChild(script);
    }
  }

  // Fallback only: if the widget script never loaded, the data attributes are
  // inert, so open the hosted form in a new tab rather than leaving a dead button.
  document.querySelectorAll<HTMLElement>("[data-tally-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if ((window as any).Tally) return; // widget handles it
      window.open(`https://tally.so/r/${button.dataset.tallyOpen}`, "_blank", "noopener");
    });
  });
</script>
