---
import { TALLY_FORM_ID, tallyEmbedSrc } from "../data/forms";

interface Props {
  /** Optional override if a page ever needs a different Tally form. */
  formId?: string;
  title?: string;
}

const { formId = TALLY_FORM_ID, title = "Request a Quote" } = Astro.props;
const isConfigured = formId !== "REPLACE_WITH_TALLY_FORM_ID";
---

{
  isConfigured ? (
    <div class="tally-wrap">
      <iframe
        data-tally-src={tallyEmbedSrc(formId)}
        loading="lazy"
        width="100%"
        height="240"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title={title}
      />
      <noscript>
        <p>
          <a href={`https://tally.so/r/${formId}`} target="_blank" rel="noopener">
            Open the booking form
          </a>
        </p>
      </noscript>
    </div>
  ) : (
    <div class="tally-wrap tally-missing">
      <p>
        <strong>Form not connected yet.</strong> Add your Tally form ID to
        <code>src/data/forms.ts</code>.
      </p>
      <p>
        In the meantime, reach us at <a href="tel:+14808269400">(480) 826-9400</a> or
        <a href="mailto:info@heavydjs.com">info@heavydjs.com</a>.
      </p>
    </div>
  )
}

<style>
  .tally-wrap {
    width: 100%;
  }

  .tally-wrap iframe {
    width: 100%;
    border: 0;
    display: block;
  }

  .tally-missing {
    background: var(--cream-soft);
    border: 1px dashed rgb(0 0 0 / 0.25);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .tally-missing p {
    margin-bottom: 0.5rem;
  }

  .tally-missing a {
    color: var(--pink);
    font-weight: 600;
  }

  .tally-missing code {
    background: rgb(0 0 0 / 0.06);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
</style>

<script>
  // Tally's loader swaps data-tally-src onto src and handles dynamic height.
  // Load it once per page, even if several embeds are present.
  const TALLY_SCRIPT = "https://tally.so/widgets/embed.js";

  function mountEmbeds() {
    if (typeof (window as any).Tally !== "undefined") {
      (window as any).Tally.loadEmbeds();
      return;
    }
    // Fallback if the widget script is blocked: show the frame anyway.
    document.querySelectorAll<HTMLIFrameElement>("iframe[data-tally-src]").forEach((frame) => {
      if (!frame.src) frame.src = frame.dataset.tallySrc!;
    });
  }

  if (document.querySelector("iframe[data-tally-src]")) {
    if (document.querySelector(`script[src="${TALLY_SCRIPT}"]`)) {
      mountEmbeds();
    } else {
      const script = document.createElement("script");
      script.src = TALLY_SCRIPT;
      script.onload = mountEmbeds;
      script.onerror = mountEmbeds;
      document.body.appendChild(script);
    }
  }
</script>
