---
interface Props {
  title: string;
  heading: string;
  body: string;
}

const { title, heading, body } = Astro.props;
---

<section class="stub">
  <div class="container stub-inner reveal">
    <p class="eyebrow">Heavy DJ Apparel</p>
    <h1>{heading}</h1>
    <p>{body}</p>
    <a href="/store/" class="btn btn-outline">Back to Store</a>
  </div>
</section>

<style>
  .stub {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .stub-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .stub-inner h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0 1rem;
  }

  .stub-inner p {
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }
</style>
