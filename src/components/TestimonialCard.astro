---
import type { Testimonial } from "../data/testimonials";

interface Props {
  testimonial: Testimonial;
  variant?: "default" | "blue";
}

const { testimonial, variant = "default" } = Astro.props;
const isBlue = variant === "blue";
---

<figure class={`testimonial card reveal ${isBlue ? "testimonial-blue" : ""}`}>
  {
    /* the original shows stars only on the top row, above the quote */
    !isBlue && (
      <div class="stars" aria-hidden="true">
        {"★".repeat(testimonial.rating ?? 5)}
      </div>
    )
  }
  <blockquote>&ldquo;{testimonial.quote}</blockquote>
  {testimonial.pullQuote && <p class="pull-quote">{testimonial.pullQuote}&rdquo;</p>}
  <figcaption>
    {testimonial.location ? `${testimonial.name} | ${testimonial.location}` : testimonial.name}
  </figcaption>
</figure>

<style>
  .testimonial {
    /* figure carries a default 1em 40px margin — clear it */
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .stars {
    color: var(--yellow);
    font-size: 1.75rem;
    letter-spacing: 0.1em;
  }

  blockquote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
  }

  /* matches the original attribution: 19.2px / 600 / 28.8px, single piped line */
  figcaption {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .pull-quote {
    font-size: 1rem;
    line-height: 1.5;
  }

  /* the original left-aligns the bottom (blue) cards; only the top strip is centered */
  .testimonial-blue {
    background: var(--blue);
    text-align: start;
  }
</style>
