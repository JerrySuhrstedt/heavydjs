---
const photos = [
  { src: "/images/gallery-groom-flying.jpg", alt: "Groom lifted by the crowd on the dance floor" },
  { src: "/images/gallery-mirror-ball.jpg", alt: "Mirror ball over a packed dance floor" },
  { src: "/images/gallery-bride-flowers.jpg", alt: "Bride tossing her bouquet" },
  { src: "/images/gallery-couple-dance.jpg", alt: "Couple dancing at their wedding reception" },
  { src: "/images/gallery-party-girls.jpg", alt: "Guests dancing at a party" },
  { src: "/images/gallery-bride-gown.jpg", alt: "Bride dancing, gown flying" },
];
---

<section class="gallery-section">
  <div class="container gallery-grid">
    {
      photos.map((photo) => (
        <figure class="gallery-item reveal">
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .gallery-section {
    padding-block: 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
