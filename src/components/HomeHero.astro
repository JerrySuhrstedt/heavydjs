---
import Sparkle from "./Sparkle.astro";

const sparkles = [
  { color: "var(--pink)", size: 38, style: "top: -6%; left: 3%;" },
  { color: "var(--blue)", size: 16, style: "top: 12%; left: 10%;" },
  { color: "var(--orange)", size: 34, style: "top: -2%; right: 5%;" },
  { color: "var(--pink)", size: 14, style: "top: 11%; right: 11%;" },
  { color: "var(--pink)", size: 15, style: "bottom: 10%; left: 12%;" },
  { color: "var(--orange)", size: 30, style: "bottom: 4%; left: 20%;" },
  { color: "var(--blue)", size: 28, style: "bottom: 12%; right: 20%;" },
  { color: "var(--orange)", size: 16, style: "bottom: 6%; right: 12%;" },
];

const behindSparkles = [
  { color: "var(--pink)", size: 30, style: "top: 38%; left: 47%;" },
  { color: "var(--orange)", size: 20, style: "top: 34%; left: 43%;" },
];
---

<section class="hero">
  <div class="container hero-inner">
    {sparkles.map((s) => <Sparkle color={s.color} size={s.size} class="deco" style={s.style} />)}

    <p class="eyebrow">Phoenix Area Wedding &amp; Event DJs</p>
    <div class="headline-wrap">
      {behindSparkles.map((s) => <Sparkle color={s.color} size={s.size} class="deco deco-behind" style={s.style} />)}
      <h1>Where music meets magic&hellip; and memories are made</h1>
    </div>
    <p class="hero-sub">We turn your wedding, corporate event, or private party into a celebration.</p>
    <a href="/dj-services/" class="btn btn-primary hero-cta">See DJ Packages</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    max-width: 900px;
    text-align: center;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .headline-wrap {
    position: relative;
    width: 100%;
  }

  h1 {
    position: relative;
    z-index: 2;
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 600;
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .hero-cta {
    margin-top: 1rem;
    font-size: 1.05rem;
  }
</style>

<style is:global>
  .hero .deco {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }

  .hero .deco-behind {
    z-index: 0;
  }

  @media (max-width: 640px) {
    .hero .deco {
      display: none;
    }
  }
</style>
