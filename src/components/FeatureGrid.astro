---
import { weFeature } from "../data/features";
---

<section class="feature-section">
  <div class="container">
    <h2>We Feature</h2>

    <ul class="feature-grid">
      {
        weFeature.map((feature) => (
          <li class="feature-item reveal">
            <svg class="feature-check" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M4 12.8l5.2 5.2L20 6.5"
                fill="none"
                stroke="var(--pink)"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature-section {
    background: var(--blue);
  }

  /* original: 44.8 / 500 / 44.8 */
  .feature-section h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    line-height: 1;
    margin-bottom: 2.5rem;
  }

  /* original fills column-first: items 1-5 left, 6-10 right */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(5, auto);
    grid-auto-flow: column;
    gap: 1.5rem 3rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .feature-check {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    margin-top: 0.6rem;
  }

  /* matches the original: 28.8px / 43.2px heading, 16px / 24px body */
  .feature-item h3 {
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.5;
    margin-bottom: 0.1rem;
  }

  .feature-item p {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .feature-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
      gap: 1.25rem;
    }
  }
</style>
