---
import { weFeature } from "../data/features";
---

<section class="feature-section">
  <div class="container">
    <h2>We Feature</h2>

    <ul class="feature-grid">
      {
        weFeature.map((feature) => (
          <li class="feature-item reveal">
            <svg class="feature-check" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="11" fill="var(--ink)" />
              <path
                d="M7 12.5l3.2 3.2L17 9"
                fill="none"
                stroke="#fff"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature-section {
    background: var(--blue);
  }

  .feature-section h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 2.5rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 3rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .feature-check {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .feature-item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .feature-item p {
    color: rgb(0 0 0 / 0.7);
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
