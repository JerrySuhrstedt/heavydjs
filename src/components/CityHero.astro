---
import Sparkle from "./Sparkle.astro";
import EventForm from "./EventForm.astro";
import type { CityVariant } from "../data/cities";

interface Props {
  city: string;
  serviceLabel: string;
  variant: CityVariant;
}

const { city, serviceLabel, variant } = Astro.props;

// A strip of real event photography fills the space beside the form. The
// starting point rotates per page so all 30 city pages don't show the same
// four shots in the same order.
const photoPool = [
  { src: "/images/home-wedding-dancing.webp", alt: "Wedding guests line dancing" },
  { src: "/images/gallery-groom-flying.jpg", alt: "Groom lifted by the crowd" },
  { src: "/images/home-dj-mixing.webp", alt: "Heavy DJs mixing at an event" },
  { src: "/images/gallery-party-girls.jpg", alt: "Guests dancing at a party" },
  { src: "/images/gallery-couple-dance.jpg", alt: "Couple dancing at their reception" },
  { src: "/images/bg-girls-dancing.webp", alt: "Friends dancing on a packed floor" },
  { src: "/images/gallery-mirror-ball.jpg", alt: "Mirror ball lighting up the dance floor" },
];

// Only 3 tiles fill the 4-column strip — the 4th stays empty (page background
// showing through) rather than being backfilled with a repeat.
const seed = [...`${variant}-${city}`].reduce((n, ch) => n + ch.charCodeAt(0), 0);
const heroPhotos = Array.from({ length: 3 }, (_, i) => photoPool[(seed + i) % photoPool.length]);

// "near me" and "services" each target a different keyword and carry their own
// copy, so they don't read as duplicates of the "Ultimate ..." pages.
const isNearMe = variant === "near-me";
const isServices = variant === "services";

const eyebrow = isNearMe
  ? `Mobile DJ Near Me – ${city} AZ`
  : isServices
    ? `DJ Services – ${city} AZ`
    : `Ultimate ${serviceLabel} ${city} AZ | Unforgettable Events Everyone Will Talk About`;

const heading = isNearMe
  ? "Make Your Event the Ultimate Party!"
  : isServices
    ? `Complete DJ Services in ${city}, Arizona`
    : "Make Your Event the Ultimate Party Everyone Talks About";

const body = isNearMe
  ? [
      `Looking for a Mobile DJ Near Me to bring energy and excitement to your event?`,
      `Whether it's a wedding, corporate party, or private celebration, a professional mobile DJ sets the perfect mood with expert mixing, top-tier sound equipment, and a crowd-pleasing playlist.`,
      `From old-school classics to today's hits, a skilled DJ knows how to keep the dance floor packed.`,
      `Book a Mobile DJ Near Me today for an unforgettable experience!`,
    ]
  : isServices
    ? [
        `Heavy DJs provides full DJ services in ${city}, Arizona — everything from the sound system and lighting to the emceeing that holds your timeline together.`,
        `Every package includes a professional DJ and emcee, a playlist built around your crowd, and professional audio delivered, set up, and torn down at no extra charge.`,
        `We cover weddings, corporate events, private parties, and house parties, plus themed nights spanning 80s throwbacks, funk and soul, disco and house, Latin rhythms, lowrider oldies, and swing.`,
        `Tell us your date and we'll confirm availability and send a quote.`,
      ]
    : [
        `With 25 years of experience, HEAVY DJs bring the beats, the energy, and the perfect vibe to your wedding, corporate event, or private party.`,
        `We know how to keep the dance floor packed and ensure that every moment flows seamlessly, from the first announcement to the last song of the night.`,
        `Beyond just playing music, we pride ourselves on creating unforgettable experiences tailored to your event's unique style and needs.`,
        `Whether it's an elegant wedding reception, a high-energy corporate event, or a laid-back private party, our DJs and emcees will keep your guests entertained, engaged, and talking about your event long after it's over.`,
      ];
---

<section class="city-hero">
  <div class="container city-hero-inner">
    <Sparkle color="var(--blue)" size={26} class="deco deco-1" />
    <Sparkle color="var(--pink)" size={20} class="deco deco-2" />

    <div class="city-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {!isNearMe && !isServices && <p class="city-hero-sub">Your {serviceLabel} {city} AZ</p>}

      {body.map((para) => <p class="city-hero-body">{para}</p>)}

      <ul class="city-hero-list">
        <li>A packed dance floor filled with happy guests</li>
        <li>Seamless event flow, thanks to professional emceeing</li>
        <li>Music tailored to your crowd, making your event truly fun</li>
      </ul>
    </div>

    <div class="city-hero-photos" aria-hidden="true">
      {heroPhotos.map((photo) => <img src={photo.src} alt={photo.alt} loading="lazy" />)}
    </div>

    <aside class="city-hero-form" aria-label="Check your date">
      {/* Tally's dynamicHeight never fires for pre-rendered embeds, so the
          height is pinned. Measured 1011px at this column's 360px width.
          Re-measure (with a cache-busting query param — the embed is cached
          hard) whenever the form's fields change in Tally. */}
      <EventForm title={`Request a quote — ${city} AZ`} minHeight={1020} />
    </aside>
  </div>
</section>

<style>
  .city-hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }

  /* Copy on the left, lead form on the right. The form column is capped so the
     embed doesn't stretch, and sticks while the long copy scrolls past. */
  .city-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 3rem;
    align-items: start;
    text-align: left;
  }

  .city-hero-copy {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  /* The form spans both rows and sits above the photo strip, so the strip can
     run underneath it and bleed off the right edge of the viewport. */
  .city-hero-form {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: sticky;
    top: 6rem;
    z-index: 2;
  }

  .city-hero-photos {
    grid-column: 1 / -1;
    grid-row: 2;
    z-index: 1;
    align-self: end;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    /* bleed past the container to the right edge of the viewport */
    margin-right: calc((100% - 100vw) / 2);
    border-radius: var(--radius-md) 0 0 var(--radius-md);
    overflow: hidden;
  }

  .city-hero-photos img {
    width: 100%;
    height: clamp(220px, 26vw, 340px);
    object-fit: cover;
    display: block;
    border: 1px solid var(--hairline);
  }

  h1 {
    font-size: clamp(2.2rem, 4.2vw, 3.1rem);
    font-weight: 600;
  }

  .city-hero-sub {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--pink);
  }

  .city-hero-body {
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .city-hero-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    margin-top: 0.5rem;
  }

  .city-hero-list li {
    padding-left: 1.5rem;
    position: relative;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .city-hero-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
  }

  .deco {
    position: absolute;
  }

  .deco-1 {
    top: 0;
    right: 10%;
  }

  .deco-2 {
    bottom: 10%;
    left: 8%;
  }

  /* Stack below the two-column breakpoint; the form drops under the copy and
     stops being sticky so it doesn't trail the user down the page. */
  @media (max-width: 900px) {
    .city-hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .city-hero-copy,
    .city-hero-form,
    .city-hero-photos {
      grid-column: 1;
      grid-row: auto;
    }

    .city-hero-form {
      position: static;
      max-width: 480px;
      width: 100%;
    }

    /* stacked: no bleed, round all corners, fewer tiles so they stay legible */
    .city-hero-photos {
      margin-right: 0;
      grid-template-columns: repeat(2, 1fr);
      border-radius: var(--radius-md);
    }

    .city-hero-photos img {
      height: clamp(150px, 34vw, 220px);
    }
  }

  @media (max-width: 640px) {
    .deco {
      display: none;
    }
  }
</style>
