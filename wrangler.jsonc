{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heavydjs",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  // main is intentionally omitted here - @astrojs/cloudflare needs it unset
  // to resolve its own virtual entrypoint during `astro build` (it can't
  // exist yet on a clean build). The adapter writes a fully resolved,
  // deploy-ready copy of this config to dist/server/wrangler.json after
  // every build - deploy with that file, not this one directly.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  // @astrojs/cloudflare enables Astro's session feature by default and
  // auto-provisions a KV namespace for it, even though nothing in this
  // project uses sessions. Declared explicitly (pointing at the namespace
  // that already exists) so the adapter uses this instead of trying to
  // auto-create a new one with the same name every deploy, which fails
  // once one already exists (error 10014).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "49ad4ba2169444d89c8b439192931f5c"
    }
  ],
  "observability": {
    "enabled": true
  }
}
