# Copy to .env (already gitignored). Public/client-exposed - safe to embed
# in the built site, but kept out of git so each environment sets its own.
#
# For local dev, use Cloudflare's official test key (always passes, works on
# any hostname including localhost) rather than the real one - real Turnstile
# keys are scoped to specific hostnames and localhost can hit long domain-
# propagation delays even when correctly configured:
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
